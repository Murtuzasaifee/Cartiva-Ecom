# Copy to .env and fill in. Never commit the real .env file.
#
# Uses the JWT Bearer flow (not username-password — many orgs, including
# newer Developer Editions, block that flow at Setup > OAuth and OpenID
# Connect Settings, and it's not always admin-toggleable). See README.md
# for the Connected App + certificate setup steps.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_USERNAME=
# Path *inside the container* to the private key — leave as-is if you used
# run-local.sh / the backend/certs/ convention from the README.
SALESFORCE_JWT_PRIVATE_KEY_PATH=/app/certs/server.key
SALESFORCE_POLLING_ENABLED=true
